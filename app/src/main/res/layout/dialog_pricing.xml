<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/pricing_freemium"
            android:textColor="?attr/colorPrimary"
            android:textSize="18sp"
            android:textStyle="bold" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="@string/pricing_freemium_desc"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="13sp" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="• IMEI 1/2, Hardware Serial, Bluetooth MAC, WiFi MAC/SSID"
            android:textSize="13sp"
            android:textColor="?attr/colorOnSurface" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="• Mobile Number, Advertising ID"
            android:textSize="13sp"
            android:textColor="?attr/colorOnSurface" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="?attr/colorOutlineVariant" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/pricing_silver"
            android:textColor="?attr/colorPrimary"
            android:textSize="18sp"
            android:textStyle="bold" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="@string/pricing_silver_desc"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="13sp" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="• Everything in Freemium + Country, SIM Operator, SIM MCC/MNC"
            android:textSize="13sp"
            android:textColor="?attr/colorOnSurface" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="• SIM Subscriber (IMSI), SIM Card Serial (ICCID)"
            android:textSize="13sp"
            android:textColor="?attr/colorOnSurface" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="• Google Service Framework (GSF), Spoof Google Accounts"
            android:textSize="13sp"
            android:textColor="?attr/colorOnSurface" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="?attr/colorOutlineVariant" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/pricing_premium"
            android:textColor="?attr/colorPrimary"
            android:textSize="18sp"
            android:textStyle="bold" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="@string/pricing_premium_desc"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="13sp" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="• Everything in Silver + Android ID, DRM Media ID"
            android:textSize="13sp"
            android:textColor="?attr/colorOnSurface" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="• One Click Random All, Backup/Restore"
            android:textSize="13sp"
            android:textColor="?attr/colorOnSurface" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="?attr/colorOutlineVariant" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/pricing_alpha"
            android:textColor="?attr/colorPrimary"
            android:textSize="18sp"
            android:textStyle="bold" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="@string/pricing_alpha_desc"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="13sp" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="• Everything in Premium + Hide Root/Xposed, Mock Location"
            android:textSize="13sp"
            android:textColor="?attr/colorOnSurface" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="• App Groups, Per-App Profiles, Profile Notes"
            android:textSize="13sp"
            android:textColor="?attr/colorOnSurface" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="• Backup/Restore app data"
            android:textSize="13sp"
            android:textColor="?attr/colorOnSurface" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/pricing_note"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="11sp"
            android:padding="8dp" />
    </LinearLayout>
</ScrollView>
